{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "Default": "Server=.;Database=KNStore-Catalog;Integrated Security = true;TrustServerCertificate=true",
        "HangFireConnection": "Server=.;Database=KNStore-HangFire;Integrated Security = true;TrustServerCertificate=true"
    },
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Expressions" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/ErrorLogger.txt",
                    "rollingInterval": "Day",
                    "restrictedToMinimumLevel": "Error"
                }
            },
            {
                "Name": "Logger",
                "Args": {
                    "configureLogger": {
                        "Filter": [
                            {
                                "Name": "ByIncludingOnly",
                                "Args": { "expression": "IsDefined(@p['StatusCode'])" }
                            }
                        ],
                        "WriteTo": [
                            {
                                "Name": "File",
                                "Args": {
                                    "path": "Logs/RequestLogger.txt",
                                    "rollingInterval": "Day"
                                }
                            }
                        ]
                    }
                }
            }
        ]
    },
    "RabbitMQ": {
        "Host": "localhost"
    },
    "CloudflareR2": {
        "AccessKey": "fa94b1ad8bff005a189cfcb7b9f5c810",
        "SecretKey": "ed26b1810f00be65e6f731b0ff1daa27af39f8k5d84e85b295fe385e570eb9fd",
        "BucketName": "BucketNameHere",
        "ServiceUrl": "https://5613285db90d6ceaee195507c10badbe.r2.cloudflarestorage.com",
        "PublicUrl": null
    },
    "JwtConfig": {
        "Key": "ThisIsTheGreatestKeyEverThatIsLongEnoughToWork",
        "Issuer": "https://iamtheissuer",
        "Audience": "https://iamtheaudience"
    }
}
